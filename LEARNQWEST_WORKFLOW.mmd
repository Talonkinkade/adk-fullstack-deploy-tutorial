%% ============================================================================
%% LEARNQWEST MASTER WORKFLOW - Living Appendable Diagram
%% Team LINK Digital Self Partnership
%% ============================================================================
%% CHANGELOG:
%% 2025-11-16-001: Initial architecture map - 8-tier Ion system, ADA orchestrator, YouTube pipeline
%% ============================================================================

graph TB
    %% ============================================================================
    %% TIER 1: MASTER ORCHESTRATION
    %% ============================================================================
    subgraph Tier1_Orchestration["🎯 TIER 1: Master Orchestration"]
        ADA["ADA Master Orchestrator<br/>2025-11-16<br/>Status: Core Architecture"]
        TeamLinkControl["Team LINK Control Hub<br/>Multi-Agent Coordination"]
        WorkflowEngine["Workflow State Engine<br/>Task Distribution"]

        ADA -->|orchestrates| TeamLinkControl
        ADA -->|manages| WorkflowEngine
    end

    %% ============================================================================
    %% TIER 2: CONTENT INGESTION & PROCESSING
    %% ============================================================================
    subgraph Tier2_Ingestion["📥 TIER 2: Content Ingestion"]
        YouTubeCollector["Ion-YouTube-Collector<br/>Video Discovery & Metadata"]
        TranscriptAgent["Ion-Transcript-Extractor<br/>Audio-to-Text Processing"]
        ContentValidator["Ion-Content-Validator<br/>Quality & Compliance Checks"]

        YouTubeCollector -->|extracts metadata| TranscriptAgent
        TranscriptAgent -->|raw transcript| ContentValidator
        ContentValidator -->|validated content| Tier3_Analysis
    end

    %% ============================================================================
    %% TIER 3: INTELLIGENT ANALYSIS
    %% ============================================================================
    subgraph Tier3_Analysis["🧠 TIER 3: Intelligent Analysis"]
        ConceptExtractor["Ion-Concept-Extractor<br/>Topic & Key Ideas"]
        TEKSMapper["Ion-TEKS-Mapper<br/>Texas Standards Alignment"]
        LearningObjectives["Ion-Learning-Objectives<br/>Educational Goal Setting"]
        DifficultyAnalyzer["Ion-Difficulty-Analyzer<br/>Grade Level Assessment"]

        ConceptExtractor -->|concepts| TEKSMapper
        TEKSMapper -->|aligned standards| LearningObjectives
        ConceptExtractor -->|content analysis| DifficultyAnalyzer
        LearningObjectives -->|objectives| Tier4_Generation
        DifficultyAnalyzer -->|grade metadata| Tier4_Generation
    end

    %% ============================================================================
    %% TIER 4: CONTENT GENERATION
    %% ============================================================================
    subgraph Tier4_Generation["✍️ TIER 4: Content Generation"]
        LessonPlanGen["Ion-Lesson-Plan-Generator<br/>Structured Lesson Creation"]
        QuizGenerator["Ion-Quiz-Generator<br/>Assessment Creation"]
        ActivityDesigner["Ion-Activity-Designer<br/>Interactive Learning Tasks"]
        SummaryWriter["Ion-Summary-Writer<br/>Key Takeaways"]

        LessonPlanGen -->|lesson structure| Tier5_Enhancement
        QuizGenerator -->|assessments| Tier5_Enhancement
        ActivityDesigner -->|activities| Tier5_Enhancement
        SummaryWriter -->|summaries| Tier5_Enhancement
    end

    %% ============================================================================
    %% TIER 5: ENHANCEMENT & ENRICHMENT
    %% ============================================================================
    subgraph Tier5_Enhancement["🎨 TIER 5: Enhancement"]
        VisualEnhancer["Ion-Visual-Enhancer<br/>Diagram & Image Generation"]
        ExampleGenerator["Ion-Example-Generator<br/>Real-World Applications"]
        AccessibilityAgent["Ion-Accessibility<br/>Inclusive Content Adaptation"]
        MultilingualAgent["Ion-Multilingual<br/>Language Support"]

        VisualEnhancer -->|enhanced materials| Tier6_QA
        ExampleGenerator -->|contextualized examples| Tier6_QA
        AccessibilityAgent -->|accessible content| Tier6_QA
        MultilingualAgent -->|translated materials| Tier6_QA
    end

    %% ============================================================================
    %% TIER 6: QUALITY ASSURANCE
    %% ============================================================================
    subgraph Tier6_QA["✅ TIER 6: Quality Assurance"]
        PedagogicalReviewer["Ion-Pedagogical-Reviewer<br/>Educational Best Practices"]
        AccuracyChecker["Ion-Accuracy-Checker<br/>Fact Verification"]
        BiasDetector["Ion-Bias-Detector<br/>Fairness & Inclusivity"]
        ComplianceValidator["Ion-Compliance-Validator<br/>TEKS & Standards Check"]

        PedagogicalReviewer -->|approved| Tier7_Delivery
        AccuracyChecker -->|verified| Tier7_Delivery
        BiasDetector -->|bias-free| Tier7_Delivery
        ComplianceValidator -->|compliant| Tier7_Delivery
    end

    %% ============================================================================
    %% TIER 7: DELIVERY & PACKAGING
    %% ============================================================================
    subgraph Tier7_Delivery["📦 TIER 7: Delivery & Packaging"]
        PackagingAgent["Ion-Content-Packager<br/>Format & Structure"]
        MetadataEnricher["Ion-Metadata-Enricher<br/>Searchability & Tagging"]
        ExportManager["Ion-Export-Manager<br/>Multiple Format Output"]
        DistributionAgent["Ion-Distribution<br/>Platform Delivery"]

        PackagingAgent -->|packaged content| MetadataEnricher
        MetadataEnricher -->|enriched package| ExportManager
        ExportManager -->|ready for delivery| DistributionAgent
        DistributionAgent -->|delivers| Tier8_Analytics
    end

    %% ============================================================================
    %% TIER 8: ANALYTICS & CONTINUOUS IMPROVEMENT
    %% ============================================================================
    subgraph Tier8_Analytics["📊 TIER 8: Analytics & Learning"]
        UsageAnalyzer["Ion-Usage-Analyzer<br/>Engagement Metrics"]
        FeedbackCollector["Ion-Feedback-Collector<br/>User Input Processing"]
        PerformanceMonitor["Ion-Performance-Monitor<br/>System Health"]
        ImprovementEngine["Ion-Improvement-Engine<br/>Continuous Learning"]

        UsageAnalyzer -->|insights| ImprovementEngine
        FeedbackCollector -->|user feedback| ImprovementEngine
        PerformanceMonitor -->|system metrics| ImprovementEngine
        ImprovementEngine -->|recommendations| ADA
    end

    %% ============================================================================
    %% SUPPORTING INFRASTRUCTURE
    %% ============================================================================
    subgraph Infrastructure["🔧 Infrastructure Layer"]
        ADK_Backend["ADK Python Backend<br/>Agent Runtime & API"]
        NextJS_Frontend["Next.js Frontend<br/>UI & Streaming"]
        VertexAI["Vertex AI Agent Engine<br/>Cloud Deployment"]
        DataStore["Vector Store & Cache<br/>Content Repository"]

        ADK_Backend -->|serves agents| ADA
        NextJS_Frontend -->|user interface| ADK_Backend
        VertexAI -->|hosts| ADK_Backend
        DataStore -->|stores| Tier2_Ingestion
        DataStore -->|retrieves| Tier7_Delivery
    end

    %% ============================================================================
    %% CROSS-TIER CONNECTIONS
    %% ============================================================================
    WorkflowEngine -->|assigns tasks| Tier2_Ingestion
    WorkflowEngine -->|coordinates| Tier3_Analysis
    WorkflowEngine -->|manages pipeline| Tier4_Generation
    TeamLinkControl -->|monitors all tiers| Tier8_Analytics

    %% ============================================================================
    %% SPECIAL PURPOSE AGENTS
    %% ============================================================================
    subgraph SpecialPurpose["🎯 Special Purpose Agents"]
        InterviewPrepAgent["Ion-Interview-Prep<br/>Job Readiness Training"]
        CareerPathAgent["Ion-Career-Path<br/>Educational Guidance"]
        CollaborationAgent["Ion-Collaboration<br/>Multi-User Workflows"]

        InterviewPrepAgent -->|training materials| Tier4_Generation
        CareerPathAgent -->|pathway recommendations| LearningObjectives
        CollaborationAgent -->|team coordination| TeamLinkControl
    end

    %% ============================================================================
    %% EXTERNAL INTEGRATIONS
    %% ============================================================================
    subgraph External["🌐 External Systems"]
        YouTubeAPI["YouTube API<br/>Content Source"]
        TEKSDatabase["TEKS Standards DB<br/>Texas Education Standards"]
        SchoolSystems["Texas School Districts<br/>End Users"]

        YouTubeAPI -->|provides content| YouTubeCollector
        TEKSDatabase -->|standards data| TEKSMapper
        DistributionAgent -->|delivers to| SchoolSystems
    end

    %% ============================================================================
    %% STYLING
    %% ============================================================================
    classDef orchestrator fill:#ff6b6b,stroke:#c92a2a,color:#fff,stroke-width:3px
    classDef ingestion fill:#4ecdc4,stroke:#087f5b,color:#fff,stroke-width:2px
    classDef analysis fill:#95e1d3,stroke:#087f5b,color:#000,stroke-width:2px
    classDef generation fill:#f38181,stroke:#c92a2a,color:#fff,stroke-width:2px
    classDef enhancement fill:#aa96da,stroke:#5f3dc4,color:#fff,stroke-width:2px
    classDef qa fill:#fcbad3,stroke:#c92a2a,color:#000,stroke-width:2px
    classDef delivery fill:#ffffd2,stroke:#f59f00,color:#000,stroke-width:2px
    classDef analytics fill:#a8dadc,stroke:#1864ab,color:#000,stroke-width:2px
    classDef infrastructure fill:#6c757d,stroke:#212529,color:#fff,stroke-width:2px
    classDef special fill:#ffd93d,stroke:#f59f00,color:#000,stroke-width:2px
    classDef external fill:#e9ecef,stroke:#495057,color:#000,stroke-width:2px

    class ADA,TeamLinkControl,WorkflowEngine orchestrator
    class YouTubeCollector,TranscriptAgent,ContentValidator ingestion
    class ConceptExtractor,TEKSMapper,LearningObjectives,DifficultyAnalyzer analysis
    class LessonPlanGen,QuizGenerator,ActivityDesigner,SummaryWriter generation
    class VisualEnhancer,ExampleGenerator,AccessibilityAgent,MultilingualAgent enhancement
    class PedagogicalReviewer,AccuracyChecker,BiasDetector,ComplianceValidator qa
    class PackagingAgent,MetadataEnricher,ExportManager,DistributionAgent delivery
    class UsageAnalyzer,FeedbackCollector,PerformanceMonitor,ImprovementEngine analytics
    class ADK_Backend,NextJS_Frontend,VertexAI,DataStore infrastructure
    class InterviewPrepAgent,CareerPathAgent,CollaborationAgent special
    class YouTubeAPI,TEKSDatabase,SchoolSystems external
